{
  "schemaVersion": 1,
  "id": "polaris-model",
  "version": "1.0.1",
  "name": "Uptime Polaris models",
  "description": "Published model observations from another Polaris instance.",
  "categories": [
    "model"
  ],
  "capabilities": [
    "http-json",
    "heartbeat-history"
  ],
  "inputs": {
    "baseUrl": {
      "type": "url",
      "required": true
    }
  },
  "requests": {
    "status": {
      "baseUrlInput": "baseUrl",
      "method": "GET",
      "path": "/api/public/ai/models",
      "query": {
        "view": "ai"
      },
      "intervalSec": 60,
      "response": "json"
    }
  },
  "items": {
    "request": "status",
    "path": "$.models[*]",
    "fields": {
      "id": "$.id",
      "name": "$.name",
      "provider": "$.channel.name"
    }
  },
  "observations": {
    "request": "status",
    "mode": "heartbeat",
    "currentWhen": {
      "op": "eq",
      "path": "$.live.freshness",
      "value": "current"
    },
    "latestBy": "$.live.checkedAt",
    "observedAt": {
      "path": "$.live.checkedAt",
      "format": "unix-seconds"
    },
    "status": {
      "path": "$.live.outcome",
      "map": {
        "ok": "up",
        "rate_limited": "degraded",
        "quota_exhausted": "down",
        "authentication_failed": "down",
        "permission_denied": "down",
        "model_or_endpoint_unavailable": "down",
        "rate_limit_or_quota": "degraded",
        "upstream_unavailable": "down",
        "request_invalid": "down",
        "timeout": "down",
        "network_error": "down",
        "invalid_response": "down",
        "response_mismatch": "down",
        "unexpected_status": "down"
      },
      "fallback": "unknown"
    },
    "latency": {
      "path": "$.live.latencyMs",
      "unit": "ms"
    },
    "reason": "$.live.outcome"
  }
}
