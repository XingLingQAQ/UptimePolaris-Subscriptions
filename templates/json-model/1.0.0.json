{
  "schemaVersion": 1,
  "id": "json-model",
  "version": "1.0.0",
  "name": "JSON model status",
  "description": "Map your JSON model list to model status.",
  "categories": [
    "model"
  ],
  "capabilities": [
    "http-json",
    "snapshot"
  ],
  "inputs": {
    "baseUrl": {
      "type": "url",
      "required": true
    }
  },
  "requests": {
    "status": {
      "baseUrlInput": "baseUrl",
      "method": "GET",
      "path": "/status.json",
      "intervalSec": 60,
      "response": "json"
    }
  },
  "items": {
    "request": "status",
    "path": "$.models[*]",
    "fields": {
      "id": "$.id",
      "name": "$.name",
      "modelId": "$.modelId",
      "provider": "$.provider",
      "protocol": "$.protocol"
    }
  },
  "observations": {
    "request": "status",
    "mode": "snapshot",
    "status": {
      "path": "$.status",
      "map": {
        "up": "up",
        "down": "down",
        "degraded": "degraded",
        "pending": "pending",
        "maintenance": "maintenance",
        "unknown": "unknown"
      },
      "fallback": "unknown"
    }
  }
}
